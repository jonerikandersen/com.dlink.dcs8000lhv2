{
  "title": { "en": "Pan/Tilt camera" },
  "titleFormatted": { "en": "Move camera [[direction]]" },
  "args": [
    { "name": "device", "type": "device", "filter": "driver_id=camera" },
    {
      "name": "direction",
      "type": "dropdown",
      "values": [
        { "id": "up",    "label": { "en": "Up" } },
        { "id": "down",  "label": { "en": "Down" } },
        { "id": "left",  "label": { "en": "Left" } },
        { "id": "right", "label": { "en": "Right" } },
        { "id": "home",  "label": { "en": "Home (center)" } }
      ]
    }
  ]
}
