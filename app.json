{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.dlink.dcs8000lhv2",
  "version": "0.1.0",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "brandColor": "#1e5aa0",
  "name": {
    "en": "D-Link DCS-8000LHV2",
    "no": "D-Link DCS-8000LHV2"
  },
  "description": {
    "en": "Local control of the D-Link DCS-8000LHV2 Mini HD Pan & Tilt camera. Live RTSP stream, snapshots, motion alerts via ONVIF, and PTZ control. Enable Local Access (RTSP) in the mydlink app first.",
    "no": "Lokal styring av D-Link DCS-8000LHV2 Mini HD Pan & Tilt-kamera. Live RTSP-stream, snapshots, bevegelses-varsler via ONVIF, og PTZ-styring. Aktiver Local Access (RTSP) i mydlink-appen først."
  },
  "category": [
    "video"
  ],
  "tags": {
    "en": [
      "d-link",
      "dlink",
      "dcs-8000lhv2",
      "camera",
      "rtsp",
      "onvif",
      "mydlink"
    ]
  },
  "author": {
    "name": "Lokale Helter"
  },
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Motion detected"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=camera"
          }
        ],
        "id": "motion_detected"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Pan/Tilt camera"
        },
        "titleFormatted": {
          "en": "Move camera [[direction]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=camera"
          },
          {
            "name": "direction",
            "type": "dropdown",
            "values": [
              {
                "id": "up",
                "label": {
                  "en": "Up"
                }
              },
              {
                "id": "down",
                "label": {
                  "en": "Down"
                }
              },
              {
                "id": "left",
                "label": {
                  "en": "Left"
                }
              },
              {
                "id": "right",
                "label": {
                  "en": "Right"
                }
              },
              {
                "id": "home",
                "label": {
                  "en": "Home (center)"
                }
              }
            ]
          }
        ],
        "id": "ptz_move"
      },
      {
        "title": {
          "en": "Take snapshot"
        },
        "titleFormatted": {
          "en": "Take a snapshot from [[device]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=camera"
          }
        ],
        "tokens": [
          {
            "name": "image",
            "type": "image",
            "title": {
              "en": "Snapshot"
            }
          }
        ],
        "id": "take_snapshot"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "D-Link Camera",
        "no": "D-Link kamera"
      },
      "description": {
        "en": "A DCS-8000LHV2 camera. Live RTSP video, snapshots, motion alarm via ONVIF. Enable Local Access (RTSP) in the mydlink app before pairing.",
        "no": "Et DCS-8000LHV2-kamera. Live RTSP-video, snapshots, bevegelses-alarm via ONVIF. Aktiver Local Access (RTSP) i mydlink-appen før paring."
      },
      "class": "camera",
      "capabilities": [
        "alarm_motion",
        "button_up",
        "button_down",
        "button_left",
        "button_right",
        "button_home",
        "button_snapshot"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/camera/assets/images/small.png",
        "large": "/drivers/camera/assets/images/large.png"
      },
      "pair": [
        {
          "id": "connect",
          "navigation": {
            "next": "preview"
          }
        },
        {
          "id": "preview",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "value": "",
          "label": {
            "en": "IP address"
          },
          "hint": {
            "en": "Update if the camera's IP changes (use a DHCP reservation for stability)"
          }
        },
        {
          "id": "rtsp_user",
          "type": "text",
          "value": "admin",
          "label": {
            "en": "Username"
          },
          "hint": {
            "en": "Always 'admin' on DCS-8000LHV2 — don't change unless you know why"
          }
        },
        {
          "id": "rtsp_password",
          "type": "text",
          "value": "",
          "label": {
            "en": "PIN"
          },
          "hint": {
            "en": "The 6-digit PIN printed on the camera. Used for RTSP, snapshots and ONVIF."
          }
        },
        {
          "id": "profile",
          "type": "dropdown",
          "value": "profile.0",
          "label": {
            "en": "Stream profile"
          },
          "hint": {
            "en": "profile.0 = 1080p, profile.1 = 720p (lower bandwidth)"
          },
          "values": [
            {
              "id": "profile.0",
              "label": {
                "en": "1080p (profile.0)"
              }
            },
            {
              "id": "profile.1",
              "label": {
                "en": "720p (profile.1)"
              }
            }
          ]
        },
        {
          "id": "snapshot_interval_s",
          "type": "number",
          "value": 30,
          "min": 5,
          "max": 600,
          "label": {
            "en": "Snapshot interval (seconds)"
          },
          "hint": {
            "en": "How often to refresh the thumbnail. Higher = less network traffic."
          }
        },
        {
          "id": "onvif_port",
          "type": "number",
          "value": 80,
          "min": 1,
          "max": 65535,
          "label": {
            "en": "ONVIF port"
          },
          "hint": {
            "en": "Default 80 for D-Link. Adjust only if you have non-default port mapping."
          }
        },
        {
          "id": "onvif_enabled",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Enable motion detection via ONVIF"
          },
          "hint": {
            "en": "Subscribe to motion events. Requires camera to expose ONVIF."
          }
        }
      ],
      "id": "camera"
    }
  ],
  "capabilities": {
    "button_down": {
      "type": "boolean",
